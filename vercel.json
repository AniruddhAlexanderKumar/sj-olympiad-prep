{
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "server/migrations/**/*"
    }
  },
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/journey", "destination": "/index.html" },
    { "source": "/practice", "destination": "/index.html" },
    { "source": "/tutor", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/lesson/:lessonId", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ]
}
