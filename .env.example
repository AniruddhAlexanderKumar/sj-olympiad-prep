# Copy to .env for local production-style runs. Never commit real secrets.
# The server refuses to start in production without a PostgreSQL connection string.
DATABASE_URL=postgres://user:password@host:5432/axiom

# Optional: provisions (or promotes) this account to administrator on startup.
# The password must be at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Local development defaults (uncomment to override)
# DATABASE_PATH=data/axiom.sqlite
# PORT=3001
# HOST=0.0.0.0
# PG_POOL_MAX=10
